{
  "name": "truenews-core",
  "version": "2.0.0",
  "description": "Unified TrueNews platform - Merged React UI and Python M0-M9 engine",
  "private": true,
  "type": "module",
  "workspaces": [
    "frontend",
    "backend/api"
  ],
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build",
    "lint": "tsc --noEmit",
    "start": "tsx server.ts",
    "test": "npm run test:api && npm run test:python",
    "test:api": "cd backend/api && npm run test",
    "test:python": "python3 -m unittest discover -s backend/python/tests -p 'test_*.py'",
    "bench": "python3 backend/python/scripts/evaluate_all.py",
    "install:all": "npm install && cd backend/python && pip install -r requirements.txt || true",
    "docker:up": "docker-compose up"
  },
  "dependencies": {
    "express": "^4.21.2",
    "lucide-react": "^1.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^6.0.0"
  }
}
